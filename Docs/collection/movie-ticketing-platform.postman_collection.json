    {
      "name": "Movie Catalogue and Shows",
      "description": "Implemented catalogue, owned show scheduling, public discovery, and show-seat availability APIs.",
      "item": [
        {
          "name": "Admin Commands",
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{adminAccessToken}}",
                "type": "string"
              }
            ]
          },
          "item": [
            {
              "name": "Create Movie",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Movie created', function () { pm.response.to.have.status(201); });",
                      "if (pm.response.code === 201) { pm.collectionVariables.set('movieId', pm.response.json().id); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"The Last Signal {{$timestamp}}\",\n  \"durationMinutes\": 128,\n  \"languageCode\": \"hi\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/movies",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "movies"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Create Show",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const start = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);",
                      "pm.collectionVariables.set('showStartsAt', start.toISOString());",
                      "const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(start);",
                      "const value = Object.fromEntries(parts.filter(p => p.type !== 'literal').map(p => [p.type, p.value]));",
                      "pm.collectionVariables.set('showDate', `${value.year}-${value.month}-${value.day}`);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Show created', function () { pm.response.to.have.status(201); });",
                      "if (pm.response.code === 201) { pm.collectionVariables.set('showId', pm.response.json().id); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"movieId\": \"{{movieId}}\",\n  \"startsAt\": \"{{showStartsAt}}\",\n  \"currency\": \"INR\",\n  \"tierPrices\": [\n    {\n      \"tier\": \"PREMIUM\",\n      \"amount\": 400.00\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/theatres/{{theatreId}}/auditoriums/{{auditoriumId}}/shows",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "theatres",
                    "{{theatreId}}",
                    "auditoriums",
                    "{{auditoriumId}}",
                    "shows"
                  ]
                },
                "description": "Schedules a future show in the owned auditorium. The existing collection setup creates PREMIUM seats, so the exact tier-price set contains PREMIUM only."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Public Catalogue and Discovery",
          "auth": {
            "type": "noauth"
          },
          "item": [
            {
              "name": "Search Movies",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/movies?q=signal&languageCode=hi&page=0&size=20",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "movies"
                  ],
                  "query": [
                    {
                      "key": "q",
                      "value": "signal"
                    },
                    {
                      "key": "languageCode",
                      "value": "hi"
